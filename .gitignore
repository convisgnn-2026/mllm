# LLMServingSim sweep artifacts: per-request CSV/log are large and regenerable; keep summary + configs + patch
archive/legacy/results/servingsim/scratch/
archive/legacy/results/servingsim/workloads/
archive/legacy/results/servingsim/sweep1/*/sim.csv
archive/legacy/results/servingsim/sweep1/*/sim.log
archive/legacy/results/servingsim/pool/*/sim.csv
archive/legacy/results/servingsim/pool/*/sim.log
archive/legacy/results/servingsim/pool_vlm/*/sim.csv
archive/legacy/results/servingsim/pool_vlm/*/sim.log
archive/legacy/results/servingsim/swap/*/sim.csv
archive/legacy/results/servingsim/swap/*/sim.log
archive/legacy/results/servingsim/pool_park/*/sim.csv
archive/legacy/results/servingsim/pool_park/*/sim.log
archive/legacy/results/servingsim/pool_vlm_park/*/sim.csv
archive/legacy/results/servingsim/pool_vlm_park/*/sim.log
archive/legacy/results/servingsim/dynamic/*/sim.csv

# Stage 0-2b (results/hetero/stage*): keep protocol, plans, per-request records, summaries, figures.
# Server/proxy/console logs, 1 Hz nvidia-smi samples and warmup outputs are regenerable and large (47 MB).
results/hetero/stage*/**/gpu.csv
results/hetero/stage*/**/serve_*.log
results/hetero/stage*/**/proxy.log
results/hetero/stage*/**/dit_server.log
results/hetero/stage*/**/*.console.log
results/hetero/stage*/runner.log
results/hetero/stage*/runner.lock
results/hetero/stage*/**/_warmup/
# torch profiler traces (70 MB, regenerable)
results/hetero/vlm_gpu_profile_seed0/traces/

# Nsight Systems captures (results/hetero/nsys_*): raw reports are ~1 GB each and regenerable with
# bench/hetero/profile_mixed_nsys.sh; keep nsys_summary.json, timeline_*.png, dmon.txt, console logs.
results/hetero/nsys_*/**/report.sqlite
results/hetero/nsys_*/**/report.nsys-rep
results/hetero/nsys_*/**/_warmup/
results/hetero/nsys_*/**/replay/

# Nsight Systems raw captures (100+ MB each) and their sqlite exports: regenerable from the .nsys-rep, not committed.
# Keep nsys_summary*.json, timeline/fig PNGs, logs, replay records.
results/**/*.nsys-rep
results/**/*.sqlite
results/**/*.sqlite-journal
